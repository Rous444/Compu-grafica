#version 430

// Cada invocación calcula un píxel. Se agrupan de a 8 x 8 (un work group).
layout(local_size_x = 8, local_size_y = 8) in;

// La imagen donde escribimos el resultado. binding = 0 es la unidad de imagen 0.
layout(rgba8, binding = 0) uniform writeonly image2D u_output;

#include "common/scene_types.glsl"

// Los objetos de la escena, en un SSBO: un buffer de tamaño variable que el shader puede leer.
layout(std430, binding = 1) readonly buffer SceneObjects {
    SceneObject objects[];
};
uniform int u_object_count;



#include "common/raytracing.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    // La imagen no siempre es múltiplo de 8: las invocaciones que sobran no hacen nada.
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    vec2 screen_uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 color = trace(camera_ray(screen_uv));
    imageStore(u_output, pixel, vec4(clamp(color, 0.0, 1.0), 1.0));
}
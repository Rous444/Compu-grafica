#version 430

layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_types.glsl"

layout(std430, binding = 1) readonly buffer SceneObjects {
    SceneObject objects[];
};
uniform int u_object_count;
uniform int u_frame_index;
uniform int u_samples_per_frame;

// Promedio acumulado de todos los frames. rgba32f: floats, para no perder precisión al promediar.
layout(rgba32f, binding = 0) uniform image2D u_accumulation;

#include "common/pathtracing.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_accumulation);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    uint state = seed_for(pixel, u_frame_index);
    vec3 frame_color = sample_pixel(pixel, vec2(size), u_samples_per_frame, state);

    // Promedio acumulado: el frame n pesa 1 / (n + 1).
    vec3 previous = imageLoad(u_accumulation, pixel).rgb;
    vec3 averaged = mix(previous, frame_color, 1.0 / float(u_frame_index + 1));
    imageStore(u_accumulation, pixel, vec4(averaged, 1.0));
}